# Export these variables in your shell; the server does not load .env files.
# Without either API key, the app runs in clearly labelled scripted demo mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Claude takes precedence if both keys are configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
HOST=127.0.0.1
PORT=8000
